{
  "name": "personal-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal blog built with Next.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-rss.mjs && next build && node scripts/verify-export.mjs",
    "rss": "node scripts/generate-rss.mjs",
    "start": "serve out",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "overrides": {
    "serve": {
      "compression": "^1.8.2"
    }
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.23.0",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.4.47",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
